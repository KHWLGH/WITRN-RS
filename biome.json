{
  "$schema": "https://biomejs.dev/schemas/2.4.4/schema.json",
  "assist": { "actions": { "source": { "organizeImports": "on" } } },
  "linter": {
    "enabled": true,
    "rules": {
      "recommended": true,
      "correctness": {
        "noUnusedVariables": "warn",
        "noUnusedImports": "warn"
      },
      "suspicious": {
        "noDoubleEquals": "warn",
        "noExplicitAny": "off",
        "noVar": "error"
      },
      "style": {
        "useConst": "warn",
        "useTemplate": "off"
      },
      "complexity": {
        "noForEach": "off",
        "noImportantStyles": "off"
      }
    }
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 120,
    "lineEnding": "crlf"
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "single",
      "semicolons": "always"
    }
  },
  "files": {
    "includes": [
      "**",
      "!**/src/vendor",
      "!**/src/assets",
      "!**/src-tauri/target",
      "!**/src-tauri/gen",
      "!**/.vscode",
      "!**/node_modules"
    ]
  }
}
