{
  "name": "lapower",
  "version": "0.2.3",
  "private": true,
  "type": "module",
  "scripts": {
    "version:set": "node scripts/set-version.mjs",
    "test": "node --test",
    "typecheck": "tsc --noEmit -p jsconfig.json",
    "lint": "biome check --error-on-warnings .",
    "format": "biome format --write .",
    "build": "node scripts/build-dist.mjs",
    "build:dist": "node scripts/build-dist.mjs --minify",
    "bench:core": "node bench/core.mjs",
    "bench:gate": "node bench/core.mjs --compare",
    "bench:extrema": "node bench/extrema.mjs",
    "bench:startup": "node bench/startup.mjs",
    "bench:packaging": "node bench/packaging.mjs",
    "showcase:dev": "node tools/showcase/server.mjs",
    "showcase:capture": "node tools/showcase/capture.mjs"
  },
  "devDependencies": {
    "@biomejs/biome": "2.4.4",
    "@tauri-apps/cli": "2.12.1",
    "esbuild": "^0.25.10",
    "playwright": "^1.58.2",
    "typescript": "^5.8.2"
  }
}
