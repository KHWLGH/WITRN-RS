{
  "$schema": "https://schema.tauri.app/config/2",
  "app": {
    "windows": [
      {
        "title": "laPower",
        "width": 1280,
        "height": 800,
        "minWidth": 900,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false,
        "decorations": false,
        "shadow": true,
        "transparent": false,
        "backgroundColor": "#1f1f1f",
        "backgroundThrottling": "disabled",
        "additionalBrowserArgs": "--enable-gpu-rasterization --enable-features=CanvasOopRasterization"
      }
    ]
  }
}
