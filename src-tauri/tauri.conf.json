{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "WITRN-RS",
  "version": "0.2.1",
  "identifier": "com.witrn.witrnrs",
  "build": {
    "frontendDist": "../out",
    "beforeDevCommand": "node scripts/build-dist.mjs",
    "beforeBuildCommand": "node scripts/build-dist.mjs --minify"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "WITRN-RS",
        "width": 1280,
        "height": 800,
        "minWidth": 900,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false,
        "decorations": false,
        "shadow": true,
        "transparent": true,
        "backgroundColor": "#00000000"
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' asset: https://asset.localhost blob:; connect-src 'self' ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["msi", "nsis", "app", "dmg", "deb", "rpm", "appimage"],
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"]
  }
}
